# Public browser configuration only. Replace both placeholders locally.
# Never use a service-role, secret API key, password, or database URL here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# This accepts a Supabase publishable key or legacy JWT with role=anon only.
# Demo shortcuts are development-only, and always removed from production builds.
VITE_DEMO_MODE=false
