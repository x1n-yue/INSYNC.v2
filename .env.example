# Copy this file to .env and fill in your Supabase project's public settings.
# If this project already runs on another laptop, copy its .env instead.
# These values are included in the browser bundle. Never use private keys.

# HTTPS project URL; HTTP is allowed only for local loopback Supabase.
VITE_SUPABASE_URL=

# Public sb_publishable_... key or legacy anon JWT; never secret/service_role.
VITE_SUPABASE_ANON_KEY=

# No mock/demo authentication settings are used by the application.
